{"A": "<style>\n/* ZK mobile fonts v1 upsell (20.11.2026): по-едър текст на телефон */\n@media (max-width: 600px) {\n  .zku { padding-left: 8px !important; padding-right: 8px !important; }\n  .zku p:not([class]), .zku .lead, .zku .promise { font-size: 19px !important; line-height: 1.55 !important; }\n  .zku li { font-size: 18px !important; line-height: 1.5 !important; }\n  .zku .small { font-size: 15px !important; }\n  .zku .t { font-size: 21px !important; }\n  .zku .h2 { font-size: 24px !important; }\n  .zku .proof { font-size: 21px !important; }\n  .zku b { font-size: 17px !important; }\n  .zku .rh { font-size: 18px !important; }\n  .zku .rt { font-size: 17px !important; line-height: 1.55 !important; }\n  .zku .rn { font-size: 17px !important; }\n  .zku .note { font-size: 13px !important; }\n  .zku .gold { font-size: 17px !important; }\n}\n</style>\n<style>\n.zku { font-family: inherit; color: #222; max-width: 860px; margin: 0 auto; padding: 0 16px; text-align: center; }\n.zku p { margin: 0 0 12px; line-height: 1.55; font-size: clamp(16px, 1.9vw, 18px); }\n.zku .stop { font-size: clamp(34px, 5vw, 52px); font-weight: 900; color: #c0392b; letter-spacing: 1px; margin: 10px 0 6px; }\n.zku .lead { font-size: clamp(18px, 2.2vw, 22px); font-weight: 600; }\n.zku .prob { background: #fff6e8; border-left: 5px solid #e6a23c; border-radius: 10px; padding: 18px 20px; margin: 22px auto; text-align: left; max-width: 720px; }\n.zku .banner { width: 100%; max-width: 760px; border-radius: 14px; display: block; margin: 18px auto; box-shadow: 0 6px 22px rgba(0,0,0,.12); }\n.zku .cname { font-size: clamp(24px, 3.4vw, 34px); font-weight: 900; margin: 8px 0; }\n.zku .promise { font-size: clamp(17px, 2vw, 20px); max-width: 720px; margin: 0 auto 16px; }\n.zku .timer { display: inline-block; background: #222; color: #fff; font-weight: 800; font-size: clamp(26px, 4vw, 38px); letter-spacing: 2px; border-radius: 10px; padding: 8px 22px; margin: 14px 0 8px; font-variant-numeric: tabular-nums; }\n.zku .small { font-size: 14px; color: #666; }\n.zku .price { font-size: clamp(28px, 4vw, 40px); font-weight: 900; color: #c0392b; margin: 6px 0 0; }\n.zku .old { text-decoration: line-through; color: #888; }\n.zku .h2 { font-size: clamp(22px, 3vw, 30px); font-weight: 900; margin: 40px 0 16px; text-transform: none; }\n.zku .cmp { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; text-align: left; margin: 18px 0; }\n.zku .card { background: #f7f7f9; border-radius: 12px; padding: 18px; }\n.zku .card .t { font-weight: 800; font-size: 20px; margin-bottom: 10px; }\n.zku .card p { font-size: 16px; margin-bottom: 8px; }\n.zku .dur { background: #1f3a5f; color: #fff; border-radius: 12px; padding: 22px; margin: 30px 0; }\n.zku .dur p { margin: 4px 0; }\n.zku .dur .big { font-size: clamp(24px, 3.4vw, 32px); font-weight: 900; }\n.zku .list { text-align: left; max-width: 720px; margin: 0 auto; }\n.zku .list p { padding: 10px 0; border-bottom: 1px solid #eee; margin: 0; }\n.zku .proof { font-weight: 800; font-size: 20px; margin: 30px 0 10px; }\n.zku .revs { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; text-align: left; }\n.zku .rev { background: #fff; border: 1px solid #eee; border-radius: 12px; padding: 18px; box-shadow: 0 3px 12px rgba(0,0,0,.05); }\n.zku .rev .st { margin-bottom: 6px; }\n.zku .rev .rh { font-weight: 800; }\n.zku .rev .rt { font-size: 16px; }\n.zku .rev .rn { font-weight: 700; font-size: 15px; margin: 0; }\n.zku .rev .note { font-size: 12px; color: #777; font-style: italic; margin: 6px 0 0; }\n.zku .gold { background: #fff8e1; border: 2px dashed #d4a017; border-radius: 12px; padding: 20px; margin: 34px auto 0; max-width: 760px; font-weight: 700; }\n.zku .seal { width: 130px; display: block; margin: 0 auto 12px; }\n.zku .final { margin-top: 40px; }\n@media (max-width: 700px) { .zku .cmp, .zku .revs { grid-template-columns: 1fr; } }\n</style>\n<div class=\"zku\">\n\n    <!-- 1. Стоп -->\n    <p class=\"stop\">ИЗЧАКАЙ!</p>\n    <p class=\"lead\">Поръчката ти е приета, но ти предлагаме да се възползваш от още една важна възможност.</p>\n\n    <!-- 2. Проблем -->\n    <div class=\"prob\">\n        <p>Повечето хора прочитат как се прави движението...</p>\n        <p style=\"margin:0\">...но когато седнат на стола, не са сигурни дали го правят правилно и с какво темпо.</p>\n    </div>\n\n    <!-- 3. Курсът -->\n    <img class=\"banner\" src=\"https://content.app-sources.com/s/156669301007041921/uploads/Downloaded/t004-taichi-course-5208083.jpg\" alt=\"Тай чи на стол: видео програма S.E.A.T.\">\n    <p class=\"cname\">„Тай чи на стол: видео програма S.E.A.T.“</p>\n    <p class=\"promise\">Видеото показва бавно всяко движение от книгата + допълнителни уроци с най-честите грешки и как да ги избегнеш, за да имаш своя спокойна рутина за 30 дни.</p>\n\n    <!-- 4. Таймер и цена -->\n    <div class=\"timer\" id=\"zkuTimer\">05:00</div>\n    <p class=\"small\">Тази оферта е налична само на тази страница и изчезва, след като я затвориш.</p>\n    <p class=\"price\">Само 19.99€</p>\n\n</div>\n<script>\n(function(){\n  var el = document.getElementById('zkuTimer'); if (!el) return;\n  var key = 'zku_t004_end5', end = 0;\n  try { end = parseInt(sessionStorage.getItem(key) || '0', 10); } catch (e) {}\n  if (!end || end < Date.now()) { end = Date.now() + 5 * 60 * 1000; try { sessionStorage.setItem(key, String(end)); } catch (e) {} }\n  function tick(){\n    var s = Math.max(0, Math.round((end - Date.now()) / 1000));\n    var m = Math.floor(s / 60), r = s % 60;\n    el.textContent = (m < 10 ? '0' : '') + m + ':' + (r < 10 ? '0' : '') + r;\n    if (s > 0) setTimeout(tick, 1000);\n  }\n  tick();\n})();\n</script>\n", "B": "<style>\n.zku { font-family: inherit; color: #222; max-width: 860px; margin: 0 auto; padding: 0 16px; text-align: center; }\n.zku p { margin: 0 0 12px; line-height: 1.55; font-size: clamp(16px, 1.9vw, 18px); }\n.zku .stop { font-size: clamp(34px, 5vw, 52px); font-weight: 900; color: #c0392b; letter-spacing: 1px; margin: 10px 0 6px; }\n.zku .lead { font-size: clamp(18px, 2.2vw, 22px); font-weight: 600; }\n.zku .prob { background: #fff6e8; border-left: 5px solid #e6a23c; border-radius: 10px; padding: 18px 20px; margin: 22px auto; text-align: left; max-width: 720px; }\n.zku .banner { width: 100%; max-width: 760px; border-radius: 14px; display: block; margin: 18px auto; box-shadow: 0 6px 22px rgba(0,0,0,.12); }\n.zku .cname { font-size: clamp(24px, 3.4vw, 34px); font-weight: 900; margin: 8px 0; }\n.zku .promise { font-size: clamp(17px, 2vw, 20px); max-width: 720px; margin: 0 auto 16px; }\n.zku .timer { display: inline-block; background: #222; color: #fff; font-weight: 800; font-size: clamp(26px, 4vw, 38px); letter-spacing: 2px; border-radius: 10px; padding: 8px 22px; margin: 14px 0 8px; font-variant-numeric: tabular-nums; }\n.zku .small { font-size: 14px; color: #666; }\n.zku .price { font-size: clamp(28px, 4vw, 40px); font-weight: 900; color: #c0392b; margin: 6px 0 0; }\n.zku .old { text-decoration: line-through; color: #888; }\n.zku .h2 { font-size: clamp(22px, 3vw, 30px); font-weight: 900; margin: 40px 0 16px; text-transform: none; }\n.zku .cmp { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; text-align: left; margin: 18px 0; }\n.zku .card { background: #f7f7f9; border-radius: 12px; padding: 18px; }\n.zku .card .t { font-weight: 800; font-size: 20px; margin-bottom: 10px; }\n.zku .card p { font-size: 16px; margin-bottom: 8px; }\n.zku .dur { background: #1f3a5f; color: #fff; border-radius: 12px; padding: 22px; margin: 30px 0; }\n.zku .dur p { margin: 4px 0; }\n.zku .dur .big { font-size: clamp(24px, 3.4vw, 32px); font-weight: 900; }\n.zku .list { text-align: left; max-width: 720px; margin: 0 auto; }\n.zku .list p { padding: 10px 0; border-bottom: 1px solid #eee; margin: 0; }\n.zku .proof { font-weight: 800; font-size: 20px; margin: 30px 0 10px; }\n.zku .revs { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; text-align: left; }\n.zku .rev { background: #fff; border: 1px solid #eee; border-radius: 12px; padding: 18px; box-shadow: 0 3px 12px rgba(0,0,0,.05); }\n.zku .rev .st { margin-bottom: 6px; }\n.zku .rev .rh { font-weight: 800; }\n.zku .rev .rt { font-size: 16px; }\n.zku .rev .rn { font-weight: 700; font-size: 15px; margin: 0; }\n.zku .rev .note { font-size: 12px; color: #777; font-style: italic; margin: 6px 0 0; }\n.zku .gold { background: #fff8e1; border: 2px dashed #d4a017; border-radius: 12px; padding: 20px; margin: 34px auto 0; max-width: 760px; font-weight: 700; }\n.zku .seal { width: 130px; display: block; margin: 0 auto 12px; }\n.zku .final { margin-top: 40px; }\n@media (max-width: 700px) { .zku .cmp, .zku .revs { grid-template-columns: 1fr; } }\n</style>\n<div class=\"zku\">\n\n    <p class=\"small\">Добави към съществуваща поръчка. Няма нужда да попълваш отново данните си.</p>\n\n    <!-- 5. Книга срещу курс -->\n    <p class=\"promise\" style=\"margin-top:30px\">Книгата ти помага да разбереш движенията и системата S.E.A.T. Курсът ти показва на видео как да ги правиш на практика. Заедно ги научаваш по-бързо и без излишни грешки.</p>\n    <div class=\"cmp\">\n        <div class=\"card\">\n            <p class=\"t\">📖 Книгата</p>\n            <p>✔ Разбираш защо бавното движение е подходящо на всяка възраст.</p>\n            <p>✔ Научаваш 4-те стъпки на S.E.A.T.</p>\n            <p>✔ Получаваш картинка за всяко движение.</p>\n            <p>✔ Винаги е под ръка за бърза справка.</p>\n        </div>\n        <div class=\"card\">\n            <p class=\"t\">🎥 Курсът</p>\n            <p>✔ Виждаш с очите си всяко движение, бавно.</p>\n            <p>✔ Правиш го заедно с инструктора, в същото темпо.</p>\n            <p>✔ Пускаш урока отначало колкото пъти искаш.</p>\n            <p>✔ Следваш план за 30 дни, по 10-20 минути на ден.</p>\n            <p>✔ Избягваш най-честите грешки при седене и дишане.</p>\n        </div>\n    </div>\n    <p>Повечето хора имат нужда и от двете: да разберат какво да правят и да видят как точно се прави.</p>\n\n    <!-- 6. Продължителност -->\n    <div class=\"dur\">\n        <p class=\"big\">5 часа и 30 минути видео уроци</p>\n        <p><b>ДОЖИВОТЕН ДОСТЪП, НАВСЯКЪДЕ, ПО ВСЯКО ВРЕМЕ</b></p>\n    </div>\n\n    <!-- 7. Болките -->\n    <p class=\"h2\">Защо много хора спират да се движат у дома?</p>\n    <div class=\"list\">\n        <p>❌ Гледат видеа в YouTube, които са твърде бързи.</p>\n        <p>❌ Упражненията се правят на пода и ставането е трудно.</p>\n        <p>❌ Не знаят дали правят движението правилно.</p>\n        <p>❌ Започват с цял час и се отказват след седмица.</p>\n        <p>❌ Мислят, че на техните години вече е късно да започнат.</p>\n    </div>\n\n    <!-- 8. Какво ще можеш -->\n    <p class=\"h2\">Какво ще можеш да правиш след този курс?</p>\n    <div class=\"list\">\n        <p>✅ Да правиш сутрешната си рутина на стола, без да гледаш в книгата.</p>\n        <p>✅ Да дишаш спокойно и в ритъм с движението.</p>\n        <p>✅ Да седиш изправен и да движиш раменете, гърба и кръста меко.</p>\n        <p>✅ Да ставаш от стола и да се обръщаш с повече увереност.</p>\n        <p>✅ Да правиш кратка вечерна серия за отпускане.</p>\n        <p>✅ Да подредиш своя програма от 10-20 минути за всеки ден.</p>\n    </div>\n\n    <!-- 9. Какво включва курсът -->\n    <p class=\"h2\">Какво включва курсът?</p>\n    <div class=\"list\">\n        <p>👉 <b>Модул 1 - Седнал старт (50 мин):</b> как да седиш, как да дишаш и първите три основни движения.</p>\n        <p>👉 <b>Модул 2 - Меки рамене и врат (55 мин):</b> бавни кръгове с раменете, като измиваш прозорец.</p>\n        <p>👉 <b>Модул 3 - Лесен кръст (55 мин):</b> бавно въртене на кръста, като бършеш голяма маса.</p>\n        <p>👉 <b>Модул 4 - Леки колене и стъпала (55 мин):</b> движения за глезените и сигурно ставане и сядане.</p>\n        <p>👉 <b>Модул 5 - Сигурна крачка (60 мин):</b> от седеж към стоеж и първите стъпки с тай чи ритъм.</p>\n        <p>👉 <b>Модул 6 - Твоят дневен ритъм (55 мин):</b> подреждаш всичко в своя програма за сутрин и вечер.</p>\n    </div>\n\n    <!-- 10. За кого е този курс -->\n    <p class=\"h2\">ЗА КОГО Е ТОЗИ КУРС</p>\n    <div class=\"list\">\n        <p>🎥 За хора, които са взели книгата и искат да видят всяка стъпка на живо. Както и допълнителни ресурси които няма да видиш в книгата</p>\n        <p>🎥 За хора, които не са спортували от години и искат някой да им покаже как.</p>\n        <p>🎥 За хора, които учат по-лесно, когато виждат движението.</p>\n        <p>🎥 За хора, които искат ясен план ден по ден, а не още бързи видеа от интернет.</p>\n    </div>\n\n    <!-- 11. Социално доказателство -->\n    <p class=\"proof\">Над 40 000 доволни клиенти</p>\n    <div class=\"revs\">\n        <div class=\"rev\">\n            <div class=\"st\">⭐⭐⭐⭐⭐</div>\n            <p class=\"rh\">„Най-после видях как се прави“</p>\n            <p class=\"rt\">На картинката в книгата всичко ми беше ясно, но не знаех с какво темпо. На видеото правя движенията заедно с инструктора. Спирам и повтарям, докато не ми стане навик.</p>\n            <p class=\"rn\">Стефка, Габрово</p>\n            <p class=\"note\">Примерно ревю, само за тестови цели.</p>\n        </div>\n        <div class=\"rev\">\n            <div class=\"st\">⭐⭐⭐⭐⭐</div>\n            <p class=\"rh\">„Десет минути сутрин ми стигат“</p>\n            <p class=\"rt\">Пускам по един урок след закуска и го правя седнал в кухнята. След месец това ми е най-приятната част от сутринта. Жена ми вече сяда до мен.</p>\n            <p class=\"rn\">Борис, Пазарджик</p>\n            <p class=\"note\">Примерно ревю, само за тестови цели.</p>\n        </div>\n    </div>\n\n    <!-- 12. Гаранция -->\n    <div class=\"gold\">\n        🥇 ЗЛАТНА ГАРАНЦИЯ: АКО КУРСЪТ НЕ ТИ ХАРЕСА ПО КАКВАТО И ДА Е ПРИЧИНА, ПИШИ НИ ДО 60 ДНИ СЛЕД ПОКУПКАТА И ЩЕ ТИ ВЪЗСТАНОВИМ 100% ОТ ПАРИТЕ. БЕЗ ВЪПРОСИ.\n    </div>\n\n    <!-- 13. Финал -->\n    <div class=\"final\">\n        <p class=\"h2\" style=\"margin-top:0\">Искаш ли да имаш своя спокойна рутина за движение по-бързо?</p>\n        <p>Нормална цена: <span class=\"old\">50€</span></p>\n        <p class=\"price\">Днес: 19.99€</p>\n    </div>\n\n    <p class=\"note\" style=\"margin-top:14px\">Курсът предлага леки упражнения за общо добро самочувствие. Той не е медицинско лечение и не замества съвета на лекар.</p>\n\n</div>\n", "C": "<style>\n.zku { font-family: inherit; color: #222; max-width: 860px; margin: 0 auto; padding: 0 16px; text-align: center; }\n.zku p { margin: 0 0 12px; line-height: 1.55; font-size: clamp(16px, 1.9vw, 18px); }\n.zku .stop { font-size: clamp(34px, 5vw, 52px); font-weight: 900; color: #c0392b; letter-spacing: 1px; margin: 10px 0 6px; }\n.zku .lead { font-size: clamp(18px, 2.2vw, 22px); font-weight: 600; }\n.zku .prob { background: #fff6e8; border-left: 5px solid #e6a23c; border-radius: 10px; padding: 18px 20px; margin: 22px auto; text-align: left; max-width: 720px; }\n.zku .banner { width: 100%; max-width: 760px; border-radius: 14px; display: block; margin: 18px auto; box-shadow: 0 6px 22px rgba(0,0,0,.12); }\n.zku .cname { font-size: clamp(24px, 3.4vw, 34px); font-weight: 900; margin: 8px 0; }\n.zku .promise { font-size: clamp(17px, 2vw, 20px); max-width: 720px; margin: 0 auto 16px; }\n.zku .timer { display: inline-block; background: #222; color: #fff; font-weight: 800; font-size: clamp(26px, 4vw, 38px); letter-spacing: 2px; border-radius: 10px; padding: 8px 22px; margin: 14px 0 8px; font-variant-numeric: tabular-nums; }\n.zku .small { font-size: 14px; color: #666; }\n.zku .price { font-size: clamp(28px, 4vw, 40px); font-weight: 900; color: #c0392b; margin: 6px 0 0; }\n.zku .old { text-decoration: line-through; color: #888; }\n.zku .h2 { font-size: clamp(22px, 3vw, 30px); font-weight: 900; margin: 40px 0 16px; text-transform: none; }\n.zku .cmp { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; text-align: left; margin: 18px 0; }\n.zku .card { background: #f7f7f9; border-radius: 12px; padding: 18px; }\n.zku .card .t { font-weight: 800; font-size: 20px; margin-bottom: 10px; }\n.zku .card p { font-size: 16px; margin-bottom: 8px; }\n.zku .dur { background: #1f3a5f; color: #fff; border-radius: 12px; padding: 22px; margin: 30px 0; }\n.zku .dur p { margin: 4px 0; }\n.zku .dur .big { font-size: clamp(24px, 3.4vw, 32px); font-weight: 900; }\n.zku .list { text-align: left; max-width: 720px; margin: 0 auto; }\n.zku .list p { padding: 10px 0; border-bottom: 1px solid #eee; margin: 0; }\n.zku .proof { font-weight: 800; font-size: 20px; margin: 30px 0 10px; }\n.zku .revs { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; text-align: left; }\n.zku .rev { background: #fff; border: 1px solid #eee; border-radius: 12px; padding: 18px; box-shadow: 0 3px 12px rgba(0,0,0,.05); }\n.zku .rev .st { margin-bottom: 6px; }\n.zku .rev .rh { font-weight: 800; }\n.zku .rev .rt { font-size: 16px; }\n.zku .rev .rn { font-weight: 700; font-size: 15px; margin: 0; }\n.zku .rev .note { font-size: 12px; color: #777; font-style: italic; margin: 6px 0 0; }\n.zku .gold { background: #fff8e1; border: 2px dashed #d4a017; border-radius: 12px; padding: 20px; margin: 34px auto 0; max-width: 760px; font-weight: 700; }\n.zku .seal { width: 130px; display: block; margin: 0 auto 12px; }\n.zku .final { margin-top: 40px; }\n@media (max-width: 700px) { .zku .cmp, .zku .revs { grid-template-columns: 1fr; } }\n</style>\n<div class=\"zku\"><p class=\"small\" style=\"margin-top:4px\">Добави към съществуваща поръчка. Няма нужда да попълваш отново данните си.</p></div>\n", "SALES": "<style>\n.zkb .mech { list-style: none; padding: 0; margin: 14px 0 0; text-align: left; }\n.zkb .mech li { font-size: clamp(15px, 1.8vw, 17px); line-height: 1.5; margin-bottom: 10px; }\n.zkb .rev .note { font-size: 12px; color: #777; font-style: italic; margin-top: 6px; }\n.zkb .seal { width: 140px; margin: 26px auto 0; }\n.zkb .gold { max-width: 760px; margin: 40px auto 0; font-size: clamp(15px, 1.8vw, 17px); line-height: 1.6; font-weight: 700; }\n</style>\n\n<div class=\"zkb\">\n\n    <!-- ═══════════════ СЕКЦИЯ 1: ОСНОВНО ПОСЛАНИЕ ═══════════════ -->\n    <div class=\"top\">\n        <p class=\"intro\">Специално за хора над 55, които искат да се движат повече у дома</p>\n        <p class=\"headline\">\n            Как да раздвижиш тялото си с 10 минути леко движение на ден, без да ставаш от стола, чрез системата S.E.A.T., дори ако досега йогата, разходките и упражненията от YouTube не са ти пасвали.\n        </p>\n    </div>\n\n    <div class=\"tbox\">\n        <p class=\"ts\">Повечето хора не спират да се движат, защото не искат. Спират, защото упражненията им се струват твърде бързи, твърде трудни или се правят на пода.</p>\n        <p class=\"ts\">Не е „късно да започнеш“. Просто досега никой не ти е показал движение, което се прави спокойно, седнал на обикновен стол.</p>\n    </div>\n\n    <!-- ═══════════════ СЕКЦИЯ 2: КНИГА И ОФЕРТА ═══════════════ -->\n    <div class=\"hero\">\n        <div>\n            <img class=\"cover\" src=\"https://content.app-sources.com/s/156669301007041921/uploads/Downloaded/t004-taichi-cover-5208082.jpg\" alt=\"Книга Тай чи на стол\">\n        </div>\n\n        <div class=\"hero-r\">\n            <p class=\"how-t\">Как работи системата S.E.A.T.</p>\n            <p class=\"how-p\">Четири лесни стъпки, които се правят на кухненския стол, без постелка и без уреди:</p>\n\n            <ul class=\"mech\">\n                <li>🪑 <b>S - Soft (Меко):</b> бавни, плавни движения, които правиш в своето темпо.</li>\n                <li>🪑 <b>E - Easy (Лесно дишане):</b> спокоен ритъм на дишане, който те отпуска.</li>\n                <li>🪑 <b>A - Aligned (Изправено):</b> седиш изправен и движиш раменете, гърба и кръста.</li>\n                <li>🪑 <b>T - Tai chi (Тай чи):</b> свързваш движенията в кратък бавен поток от 10 минути.</li>\n            </ul>\n\n            <ul class=\"bul\">\n                <li>🍃 Сутрешна рутина, която правиш още на стола до мас